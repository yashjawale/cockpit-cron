pkgname=cockpit-cron-bin
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit plugin for managing cron jobs (prebuilt UI bundle)'
arch=('any')
url='https://github.com/yashjawale/cockpit-cron'
license=('LGPL-2.1-or-later')
depends=('cockpit' 'cronie')
source=("SOURCE")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/cockpit-cron"
  make DESTDIR="${pkgdir}" install PREFIX=/usr PREBUILT_BUNDLE=1
}
