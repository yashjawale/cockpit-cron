pkgname=cockpit-cron
pkgver=VERSION
pkgrel=1
pkgdesc='Cockit Plugin for managing cron jobs'
arch=('x86_64')
url='https://github.com/yashjawale/cockpit-cron'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
