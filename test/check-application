    def testEnableLogging(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cron")

        # ensure a clean user crontab, also when a previous test run failed
        m.execute("su admin -c 'crontab -r' || true")
        m.execute("rm -rf /home/admin/.cache/cockpit-cron || true")
        m.execute("echo '0 4 * * 1 /usr/bin/uptime' | su admin -c 'crontab -'")
        b.reload()
        b.enter_page("/cron")
        b.wait_visible("#app")
        b.click("#cron-level-user")
        b.wait_attr_contains("#cron-level-user", "class", "pf-m-selected")
        b.wait_in_text(".pf-v6-c-data-list__item", "/usr/bin/uptime")

        # enable logging from the kebab menu
        b.click(KEBAB)
        b.wait_visible(".pf-v6-c-menu")
        b.click(".pf-v6-c-menu__item:contains('Enable logging')")

        # the crontab gets a "@log" comment and the command is wrapped so that
        # its output is redirected to the log file
        b.wait(lambda: "@log" in m.execute("su admin -c 'crontab -l'"))
        output = m.execute("su admin -c 'crontab -l'")
        self.assertIn("# @log ", output)
        self.assertIn("=== run $(date -Iseconds) ===", output)
        self.assertIn("2>&1", output)
        self.assertNotIn("0 4 * * 1 /usr/bin/uptime", output)

        # the row now offers a logs button
        b.wait_visible(".cron-job-logs-toggle")

        # clean up the user crontab and log directory again
        m.execute("su admin -c 'crontab -r' || true")
        m.execute("rm -rf /home/admin/.cache/cockpit-cron || true")

