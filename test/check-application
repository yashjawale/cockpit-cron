    def testParsesRealCrontab(self):
        b = self.browser
        m = self.machine

        self.login_and_go("/cron")

        # seed a realistic crontab with env vars, comments and a non-cron line
        # around a managed job; the non-job lines are preserved
        content = "SHELL=/bin/sh\\nPATH=/sbin:/bin:/usr/sbin:/usr/bin\\n"
        content += "# BEGIN COCKPIT-CRON\\n0 4 * * 1 /usr/bin/uptime\\n# END COCKPIT-CRON\\n"
        content += "# a comment\\n# not a schedule\\n"
        m.execute(f"printf '{content}' | su admin -c 'crontab -'")
        b.reload()
        b.enter_page("/cron")
        b.wait_visible("#app")
        b.click("#cron-level-user")
        b.wait_attr_contains("#cron-level-user", "class", "pf-m-selected")

        # only the managed job is listed, not env vars or comments
        b.wait_count(".pf-v6-c-data-list__item", 1)
        b.wait_in_text(".pf-v6-c-data-list__item", "/usr/bin/uptime")
        b.wait_not_present("#cron-import-alert")

        # the non-job lines are preserved after a job edit
        b.click(".pf-v6-c-data-list__item-action .pf-v6-c-menu-toggle")
        b.wait_visible(".pf-v6-c-menu")
        b.click(".pf-v6-c-menu__item:contains('Edit')")
        b.wait_visible("#cron-command")
        b.click("#cron-add-submit")
        b.wait_not_present("#cron-command")
        output = m.execute("su admin -c 'crontab -l'")
        self.assertIn("SHELL=/bin/sh", output)
        self.assertIn("# a comment", output)

        # clean up the user crontab again
        m.execute("su admin -c 'crontab -r' || true")

