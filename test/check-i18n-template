"""Smoke-check the template before publishing it to Weblate."""

import pathlib
import sys


def main():
    pot = pathlib.Path(sys.argv[1]).read_text()
    assert 'msgid "Cron jobs"' in pot  # manifest and UI
    assert 'msgid "Cockpit Cron"' in pot  # HTML and AppStream
    assert 'msgid "Add job"' in pot  # TSX
    assert ('msgid "$0 cron job is not managed by this plugin"\n'
            'msgid_plural "$0 cron jobs are not managed by this plugin"') in pot
    assert '#-#-#-#-#' not in pot  # merged headers must not leak into the template
    assert pot.startswith('# Cockpit Cron translation template.\n')
    assert 'Report-Msgid-Bugs-To: https://github.com/yashjawale/cockpit-cron/issues' in pot


if __name__ == "__main__":
    main()
